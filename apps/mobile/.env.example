# Copy to apps/mobile/.env (git-ignored) and fill in. Restart `expo start` after changes.
# Only public values here. Never put the Supabase service-role key in this app.

# The Express API. On a phone, "localhost" is the phone itself: use this computer's LAN IP,
# e.g. http://192.168.1.20:8000, until the backend is deployed (#23).
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000

# Same project as apps/web (Supabase dashboard > Project Settings > API).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
