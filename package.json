{
  "name": "csc-3100-ama",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
    "dev": "concurrently -k -n web,api \"npm run dev --workspace=apps/web\" \"npm run dev --workspace=packages/express-backend\"",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=apps/web",
    "test": "npm run test --workspace=apps/web --workspace=packages/shared --workspace=packages/express-backend --if-present",
    "test:system": "npm run test:system --workspace=packages/express-backend",
    "lint": "npm run lint --workspace=apps/web --workspace=packages/shared --workspace=packages/express-backend --if-present",
    "apply:fill-in": "npm run apply:fill-in --workspace=packages/express-backend --",
    "mobile": "npm run start --workspace=apps/mobile",
    "typecheck:mobile": "npm run build --workspace=packages/shared && npm run typecheck --workspace=apps/mobile",
    "lint:mobile": "npm run lint --workspace=apps/mobile",
    "test:mobile": "npm run build --workspace=packages/shared && npm run test --workspace=apps/mobile"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^5.6.2"
  }
}
